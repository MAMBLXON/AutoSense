<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/severityStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/urgency_red" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:text="КРИТИЧНО"
                    tools:text="КРИТИЧНО" />

                <TextView
                    android:id="@+id/tvAtKm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:alpha="0.7"
                    android:gravity="end"
                    android:visibility="gone"
                    tools:text="~ 150 000 км"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Обрыв ремня ГРМ на 16-клапанных моторах" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="На двигателях 21126 и 21127 при обрыве ремня ГРМ гнёт клапаны..." />

            <TextView
                android:id="@+id/tvRecommendationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.6"
                android:text="РЕКОМЕНДАЦИЯ" />

            <TextView
                android:id="@+id/tvRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Меняй ремень строго каждые 60 000 км в комплекте с роликом и помпой." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>