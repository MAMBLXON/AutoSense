<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AutoSenseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSense"
        android:windowSoftInputMode="adjustResize">

        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.AutoSense">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.main.detail.DetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <receiver
            android:name=".notifications.SnoozeReceiver"
            android:exported="false" />
        <activity
            android:name=".ui.issues.CarIssuesActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.profiles.ProfilesActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />
        <activity
            android:name=".ui.history.AllHistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />
    </application>

</manifest>